---
import Base from "../layouts/Base.astro";
import source from "../data/course.html?raw";

// The course page is the syllabus's header and studio description, as HTML
// converted from syllabus.md. Its footnotes become notes, as in the vignettes
// (in the margin on wide screens, a small window on narrow ones), so updating
// the HTML from the syllabus keeps working.
const list = source.match(/<section id="footnotes"[\s\S]*?<\/section>/)?.[0] ?? "";
const notes = new Map(
  [...list.matchAll(/<li id="fn(\d+)">([\s\S]*?)<\/li>/g)].map(([, n, html]) => [
    n,
    html.replace(/<a href="#fnref\d+"[^>]*>[\s\S]*?<\/a>/g, "").replace(/<\/?p>/g, "").trim(),
  ]),
);
const html = source
  .replace(list, "")
  .replace(/<a href="#fn(\d+)" class="footnote-ref"[^>]*><sup>\d+<\/sup><\/a>/g, (_, n) =>
    `<span class="nota"><button class="nota-num" type="button" popovertarget="nota-${n}" aria-label="Note"></button><span class="nota-texto" id="nota-${n}" popover role="note">${notes.get(n) ?? ""}</span></span>`,
  )
  .replace(/<hr \/>\s*$/, "");
---
<Base title="Course">
<article class="texto" set:html={html} />
</Base>
