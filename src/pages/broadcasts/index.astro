---
import Base from "../../layouts/Base.astro";
import Remote from "../../components/Remote.astro";
import { broadcasts, aired, url, title, and, short, hour } from "../../lib/broadcasts";
const all = await broadcasts();
const upcoming = all.filter(({ b }) => !aired(b));
const archive = all.filter(({ b }) => aired(b)).reverse();
---
<Base title="Broadcasts">
<h1>Broadcasts</h1>
{upcoming.length > 0 && (
  <Fragment>
    <h2>Upcoming</h2>
    <ul class="upcoming">
      {upcoming.map(({ b, guests }) => (
        <li><time datetime={b.data.date.toISOString()}>{short(b.data.date)}, {hour(b.data.date)}</time> {b.data.theme}{guests.length > 0 && `, with ${and(guests)}`}</li>
      ))}
    </ul>
  </Fragment>
)}
{archive.length > 0 && (
  <Fragment>
    <h2>Archive</h2>
    {archive.map(({ b, guests }) => (
      <article class="archived">
        <h3><a href={url(b)}>{title(b)}</a></h3>
        <p><time datetime={b.data.date.toISOString()}>{short(b.data.date)}</time>, {Math.round((b.data.duration ?? 0) / 60)} minutes{guests.length > 0 && `, with ${and(guests)}`}.</p>
        <Remote b={b} />
        {b.data.hosts.length > 0 && <p>Hosted by {and(b.data.hosts)}.</p>}
        <p><a href={url(b)}>Read more</a></p>
      </article>
    ))}
  </Fragment>
)}
</Base>
