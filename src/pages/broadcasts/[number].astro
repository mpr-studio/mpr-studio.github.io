---
import Base from "../../layouts/Base.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const list = await getCollection("broadcasts");
  return list.map((b) => ({ params: { number: String(b.data.number) }, props: { b } }));
}
const { b } = Astro.props;
const { Content } = await render(b);
const guest = b.data.guest && (await getEntry(b.data.guest));
const bio = guest && (await render(guest));
const seconds = (t: string) => t.split(":").reduce((a, n) => a * 60 + Number(n), 0);
const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, "0")}`;
const day = b.data.date.toLocaleDateString("en-US", { timeZone: "America/New_York", weekday: "long", month: "long", day: "numeric", year: "numeric" });
const title = `Broadcast ${b.data.number}: ${b.data.theme}`;
const hosts = b.data.hosts.length > 1 ? b.data.hosts.slice(0, -1).join(", ") + " and " + b.data.hosts.at(-1) : b.data.hosts[0];
---
<Base title={title}>
<h1>{title}</h1>
<p><time datetime={b.data.date.toISOString()}>{day}</time>, {Math.round(b.data.duration / 60)} minutes</p>
<div class="show" data-src={b.data.audio} data-peaks={b.data.peaks} data-duration={b.data.duration} data-title={`Broadcast ${b.data.number}`} data-theme={b.data.theme}>
<button class="show-play" type="button" aria-label="Play">▶</button>
<div>
<p class="show-time">0:00 / {clock(b.data.duration)}</p>
<canvas class="show-wave"></canvas>
</div>
</div>
<p>Hosted by {hosts}.{guest && ` Guest: ${guest.data.name}.`}</p>
<Content />
<h2>Chapters</h2>
<ol class="chapters">
{b.data.chapters.map((c) => <li><button type="button" data-t={seconds(c.time)}>{c.time}</button> {c.title}</li>)}
</ol>
{bio && (<Fragment><h2>Guest</h2><bio.Content /></Fragment>)}
<p><a class="download" href={b.data.audio} download>Download (MP3)</a></p>
</Base>
